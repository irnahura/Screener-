{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RIOM Demo",
  "version": "0.1.0",
  "identifier": "com.riom.demo",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/**"] }
    }
  },
  "bundle": {
    "active": false
  }
}
